# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_URL=postgresql+psycopg2://sports_admin:change_me_in_env@db:5432/sports_platform
REDIS_URL=redis://redis:6379/0

# Set to "true" to use the built-in mock data provider instead of a live API.
# Keep this true until a real, authorized provider is configured and tested.
USE_MOCK_PROVIDER=true

# api-sports.io (API-NFL) key — sign up free at https://dashboard.api-football.com/register
# Dashboard -> Account -> My Access. Free tier: 100 requests/day, no credit card required.
API_SPORTS_KEY=

# balldontlie.io key (MLB, NBA, NHL, NCAAF) — sign up free at https://app.balldontlie.io
# Dashboard -> Account Settings -> API section. Free tier: 5 requests/min, Teams/Players/Games.
BALLDONTLIE_API_KEY=

# Reserved for future providers (not used yet).
SPORTS_DATA_API_KEY=
ODDS_API_KEY=

LOG_LEVEL=INFO
ENVIRONMENT=development
